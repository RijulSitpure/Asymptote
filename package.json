{
  "name": "asymptote",
  "version": "2.0.0",
  "description": "Free, open-source Socratic interview coach & complexity targeter (alternative to Leet AI)",
  "type": "module",
  "scripts": {
    "build:dataset": "node dataset/tools/build.js",
    "sync-shared": "node scripts/sync-shared.js",
    "check-shared": "node scripts/sync-shared.js --check",
    "dev": "npm run build:dataset && npm run sync-shared && vite",
    "build": "npm run build:dataset && npm run sync-shared && vite build",
    "package:extension": "npm run build && node scripts/package-extension.js",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "keywords": [
    "leetcode",
    "leet-ai",
    "patterns",
    "algorithms",
    "complexity-analysis",
    "big-o",
    "socratic-hints",
    "interview-prep"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mysql2": "^3.24.6",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.13"
  }
}
