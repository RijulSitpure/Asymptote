{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pattern.schema.json",
  "title": "Asymptote Pattern Category Schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "domain",
      "family",
      "title",
      "difficulty",
      "short_description",
      "mental_triggers",
      "constraint_signals",
      "complexity"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "domain": {
        "type": "string",
        "enum": [
          "Algorithms",
          "Database",
          "pandas",
          "Shell",
          "Concurrency",
          "JavaScript"
        ]
      },
      "family": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string"
      },
      "difficulty": {
        "type": "string"
      },
      "short_description": {
        "type": "string"
      },
      "mental_triggers": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "constraint_signals": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "complexity": {
        "type": "string"
      },
      "base_template_py": {
        "type": "string"
      },
      "base_template_cpp": {
        "type": "string"
      },
      "base_template_sql": {
        "type": "string"
      },
      "base_template_sh": {
        "type": "string"
      },
      "base_template_js": {
        "type": "string"
      },
      "dialect_notes": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "correctness_notes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "twists": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
