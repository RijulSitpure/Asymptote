{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem.schema.json",
  "title": "Asymptote Verified Problem Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "number",
    "category",
    "patterns",
    "hints",
    "complexity",
    "solutions",
    "review",
    "updated"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "Algorithms",
        "Database",
        "pandas",
        "Shell",
        "Concurrency",
        "JavaScript"
      ]
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "hints": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "title", "text"],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "time", "space", "variables", "notes"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["big-o", "query-notes", "none"]
        },
        "time": {
          "type": "string"
        },
        "space": {
          "type": "string"
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "whyNaiveFails": {
          "type": "string",
          "minLength": 1
        },
        "spaceTimeTradeoff": {
          "type": "string",
          "minLength": 1
        },
        "interviewerExpectation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "solutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lang", "code", "approach", "verifiedBy", "testedOn"],
        "properties": {
          "lang": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "approach": {
            "type": "string",
            "minLength": 1
          },
          "verifiedBy": {
            "type": "string",
            "enum": ["none", "tests", "leetcode", "both"]
          },
          "testedOn": {
            "type": ["string", "null"]
          },
          "testKind": {
            "type": "string",
            "enum": ["deterministic", "stress"]
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "acceptedOnLeetCode", "reviewer"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "tested", "reviewed"]
        },
        "acceptedOnLeetCode": {
          "type": ["string", "null"]
        },
        "reviewer": {
          "type": ["string", "null"]
        }
      }
    },
    "updated": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "enum": ["tested", "reviewed"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "complexity": {
            "required": [
              "kind",
              "time",
              "space",
              "variables",
              "notes",
              "whyNaiveFails",
              "spaceTimeTradeoff",
              "interviewerExpectation"
            ]
          }
        }
      }
    }
  ]
}
