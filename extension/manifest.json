{
  "manifest_version": 3,
  "name": "LeetCode Pattern Companion",
  "version": "1.1.0",
  "description": "Auto-syncs all accepted LeetCode submissions to your Pattern Tracker and provides in-page progressive hints.",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://leetcode.com/*",
    "*://*.leetcode.com/*",
    "http://localhost:3001/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LeetCode Pattern Tracker"
  },
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.com/*",
        "*://*.leetcode.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
