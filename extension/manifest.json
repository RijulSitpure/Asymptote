{
  "manifest_version": 3,
  "name": "Asymptote - Algorithmic Pattern Intelligence",
  "version": "2.0.0",
  "description": "Algorithmic Pattern Intelligence and in-page Socratic Mentor for LeetCode. In-page hints, Big-O complexity budget, and automatic pattern tracking.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://leetcode.com/*",
    "*://*.leetcode.com/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Asymptote",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.com/*",
        "*://*.leetcode.com/*"
      ],
      "js": [
        "languages.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/asymptote-icon-small.svg"
      ],
      "matches": [
        "*://leetcode.com/*",
        "*://*.leetcode.com/*"
      ]
    }
  ]
}
