{
  "manifest_version": 3,
  "name": "OpenLeet AI - Socratic Coach & Pattern Tracker",
  "version": "2.0.0",
  "description": "Free, open-source alternative to Leet AI ($35/mo). In-page Socratic clues, target Big-O complexity analysis, and local pattern tracking.",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://leetcode.com/*",
    "*://*.leetcode.com/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenLeet AI"
  },
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.com/*",
        "*://*.leetcode.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
